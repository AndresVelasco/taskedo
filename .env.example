NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskedo
DATABASE_MAX_CONNECTIONS=10
CLOUD_TASKS_PROJECT_ID=local-project
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=taskedo-default
CLOUD_TASKS_SERVICE_ACCOUNT=
SCHEDULER_POLL_INTERVAL_MS=60000
SCHEDULER_LOCK_TTL_MS=120000
SCHEDULER_MAX_TASKS_PER_TICK=100
DEFAULT_TENANT_ID=dev
