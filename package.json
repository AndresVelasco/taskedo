  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
